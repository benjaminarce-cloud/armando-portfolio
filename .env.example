# Copy to .env.local and fill in. Values come from the Cloudinary console
# under Settings → Access Keys. .env.local is gitignored; never commit real keys.
#
# Only the media scripts (npm run cloudinary:*) need these. The site itself
# reads Cloudinary over plain public URLs and needs no credentials.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
